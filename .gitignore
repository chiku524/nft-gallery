# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python
__pycache__/
*.py[cod]

# generated collection binaries (CSV/stats stay tracked)
/generated/images/
/generated/gifs/
/generated/json/
/generated/afterimages/images/
/generated/afterimages/gifs/
/generated/afterimages/json/
/generated/inklings/images/
/generated/inklings/gifs/
/generated/inklings/json/
/generated/placement-tests/
/generated/art-raw/

